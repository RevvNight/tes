    desc:"Studio ini ingin menarik anggota baru tanpa kehilangan komunitas lamanya. Identitas baru memakai bentuk lengkung lembut, warna hangat, dan huruf yang mudah dibaca di jadwal kelas." }
];

/* =========================================================
   SKRIP — umumnya tidak perlu diubah
   ========================================================= */
(function () {
  "use strict";
  const $  = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => Array.from(r.querySelectorAll(s));
  const store = {
    get(k){ try { return localStorage.getItem(k); } catch (e) { return null; } },
    set(k,v){ try { localStorage.setItem(k, v); } catch (e) {} }
  };

  /* ---- Isi data dari CONFIG ---- */
  const initials = CONFIG.name.split(/\s+/).map(w => w[0]).slice(0,2).join("").toUpperCase();
  $$('[data-bind="name"]').forEach(n => n.textContent = CONFIG.name);
  $$('[data-bind="name-short"]').forEach(n => n.textContent = CONFIG.name.split(/\s+/)[0]);
  $$('[data-bind="initials"]').forEach(n => n.textContent = initials);
  $$('[data-bind="email"]').forEach(n => n.textContent = CONFIG.email);
  $$('[data-bind="mail-link"]').forEach(a => a.href = "mailto:" + CONFIG.email);
  $$('[data-bind="wa-link"]').forEach(a => a.href = "https://wa.me/" + CONFIG.whatsapp);
  $("#year").textContent = new Date().getFullYear();
  $("#socials").innerHTML = CONFIG.socials.map(s =>
    `<li><a href="${s.url}" target="_blank" rel="noopener">${s.label}</a></li>`).join("");

  /* ---- Fallback jika gambar gagal dimuat ---- */
  document.addEventListener("error", function (e) {
    const img = e.target;
    if (!img || img.tagName !== "IMG") return;
    const box = img.closest("[data-ph], .thumb, .modal-img");
    if (box) box.classList.add("img-fail");
  }, true);
  $$("img").forEach(img => {
    if (img.complete && img.naturalWidth === 0 && img.getAttribute("src")) {
      const box = img.closest("[data-ph], .thumb, .modal-img");
      if (box) box.classList.add("img-fail");
    }
  });

  /* ---- Tema gelap/terang ---- */
  const root = document.documentElement;
  const savedTheme = store.get("pf-theme");
  if (savedTheme) root.dataset.theme = savedTheme;
  $("#themeBtn").addEventListener("click", () => {
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.dataset.theme = next; store.set("pf-theme", next);
  });

  /* ---- Warna utama ---- */
  const ACCENTS = [
    { name:"Kuning",  a:"#ffd23f", b:"#ff8fb1", c:"#7cc4ff" },
    { name:"Oranye",  a:"#ff7a45", b:"#ffd23f", c:"#7cc4ff" },
    { name:"Hijau",   a:"#7ed957", b:"#ffd23f", c:"#ff8fb1" },
    { name:"Biru",    a:"#5aa2ff", b:"#ffd23f", c:"#ff8fb1" },
    { name:"Merah muda", a:"#ff8fb1", b:"#ffd23f", c:"#7cc4ff" }
  ];
  const sw = $("#swatches");
  function applyAccent(i){
    const t = ACCENTS[i] || ACCENTS[0];
    root.style.setProperty("--accent", t.a);
    root.style.setProperty("--accent-2", t.b);
    root.style.setProperty("--accent-3", t.c);
    $$(".sw", sw).forEach((b, k) => b.setAttribute("aria-pressed", String(k === i)));
    store.set("pf-accent", String(i));
  }
  sw.innerHTML = ACCENTS.map((t,i) =>
    `<button class="sw" type="button" aria-label="Warna ${t.name}" aria-pressed="false" style="background:${t.a}"></button>`).join("");
  $$(".sw", sw).forEach((b,i) => b.addEventListener("click", () => applyAccent(i)));
  applyAccent(parseInt(store.get("pf-accent") || "0", 10) || 0);

  const fab = $("#fab"), palette = $("#palette");
  fab.addEventListener("click", () => {
    const open = palette.classList.toggle("open");
    fab.setAttribute("aria-expanded", String(open));
  });

  /* ---- Menu mobile ---- */
  const burger = $("#burger"), menu = $("#menu");
  function setMenu(open){
    menu.classList.toggle("open", open);
    burger.setAttribute("aria-expanded", String(open));
    burger.setAttribute("aria-label", open ? "Tutup menu" : "Buka menu");
  }
  burger.addEventListener("click", () => setMenu(!menu.classList.contains("open")));
  $$("a", menu).forEach(a => a.addEventListener("click", () => setMenu(false)));
  window.addEventListener("resize", () => { if (innerWidth > 900) setMenu(false); });
  document.addEventListener("keydown", e => {
    if (e.key !== "Escape") return;
    setMenu(false);
    palette.classList.remove("open"); fab.setAttribute("aria-expanded", "false");
  });

  /* ---- Scroll spy ---- */
  const links = $$(".menu a.link");
  const spy = new IntersectionObserver(entries => {
    entries.forEach(en => {
      if (!en.isIntersecting) return;
      links.forEach(l => l.classList.toggle("active", l.getAttribute("href") === "#" + en.target.id));
    });
  }, { rootMargin: "-45% 0px -50% 0px" });
  links.forEach(l => { const s = $(l.getAttribute("href")); if (s) spy.observe(s); });

  /* ---- Bilah keahlian: animasi saat terlihat ---- */
  const aboutGrid = $("#aboutGrid");
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver((en, o) => {
      en.forEach(x => { if (x.isIntersecting) { $("#skills").classList.add("in"); o.disconnect(); } });
    }, { threshold: .25 });
    io.observe($("#skills"));
  } else { $("#skills").classList.add("in"); }

  /* ---- Proyek: render, filter, modal ---- */
  const grid = $("#projectGrid");
  const esc = s => String(s).replace(/[&<>"']/g, c => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;" }[c]));
  grid.innerHTML = PROJECTS.map(p => `
    <button class="card project" type="button" data-id="${esc(p.id)}" data-cat="${esc(p.cat)}" aria-haspopup="dialog">
      <span class="thumb" data-ph="${esc(p.title.split(" — ")[0])}">
        <img src="${esc(p.img)}" alt="Pratinjau proyek ${esc(p.title)}" width="1200" height="750" loading="lazy">
      </span>
      <span class="project-body">
        <span class="tags">${p.tags.map(t => `<span class="tag">${esc(t)}</span>`).join("")}</span>
        <h3>${esc(p.title)}</h3>
        <p>${esc(p.short)}</p>
      </span>
    </button>`).join("");

  $$("#filters .chip").forEach(chip => chip.addEventListener("click", () => {
    const f = chip.dataset.filter;
    $$("#filters .chip").forEach(c => c.setAttribute("aria-pressed", String(c === chip)));
    $$(".project", grid).forEach(card => { card.hidden = !(f === "all" || card.dataset.cat === f); });
  }));

  const modal = $("#modal");
  let lastFocus = null;
  function openProject(id){
    const p = PROJECTS.find(x => x.id === id); if (!p) return;
    const box = $("#m-imgbox"); box.classList.remove("img-fail");
    box.dataset.ph = p.title.split(" — ")[0];
    const img = $("#m-img"); img.src = p.img; img.alt = "Pratinjau proyek " + p.title;
    $("#m-tags").innerHTML = p.tags.map(t => `<span class="tag">${esc(t)}</span>`).join("");
    $("#m-title").textContent = p.title;
    $("#m-desc").textContent = p.desc;
    $("#m-role").textContent = p.role; $("#m-year").textContent = p.year; $("#m-dur").textContent = p.dur;
    $("#m-link").href = p.link;
    lastFocus = document.activeElement;
    if (typeof modal.showModal === "function") modal.showModal(); else modal.setAttribute("open", "");
  }
  grid.addEventListener("click", e => {
    const card = e.target.closest(".project"); if (card) openProject(card.dataset.id);
  });
  function closeModal(){ if (modal.close) modal.close(); else modal.removeAttribute("open"); }
  $("#m-close").addEventListener("click", closeModal);
  $("#m-close2").addEventListener("click", closeModal);
  modal.addEventListener("click", e => { if (e.target === modal) closeModal(); });
  modal.addEventListener("close", () => { if (lastFocus) lastFocus.focus(); });

  /* ---- Efek miring 3D pada foto hero (hanya pointer halus, bukan layar sentuh) ---- */
  const tilt = $("#tilt");
  const canTilt = matchMedia("(hover:hover) and (pointer:fine)").matches && !matchMedia("(prefers-reduced-motion:reduce)").matches;
  if (canTilt) {
    const art = tilt.parentElement;
    art.addEventListener("pointermove", e => {
      const r = art.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
      tilt.classList.add("live");
      tilt.style.transform = `rotateX(${(-y * 10).toFixed(2)}deg) rotateY(${(x * 14).toFixed(2)}deg)`;
    });
    art.addEventListener("pointerleave", () => { tilt.classList.remove("live"); tilt.style.transform = ""; });
  }

  /* ---- Formulir kontak ---- */
  const form = $("#contactForm");
  const toast = $("#toast"); let tt;
  function showToast(msg){
    toast.textContent = msg; toast.classList.add("show");
    clearTimeout(tt); tt = setTimeout(() => toast.classList.remove("show"), 3800);
  }
  function setErr(input, errId, msg){
    $("#" + errId).textContent = msg;
    input.setAttribute("aria-invalid", msg ? "true" : "false");
    return !msg;
  }
  const emailOk = v => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v);
  form.addEventListener("submit", e => {
    e.preventDefault();
    const n = $("#f-name"), m = $("#f-email"), g = $("#f-msg");
    const ok = [
      setErr(n, "e-name", n.value.trim() ? "" : "Nama wajib diisi."),
      setErr(m, "e-email", !m.value.trim() ? "Email wajib diisi." : (emailOk(m.value.trim()) ? "" : "Format email belum benar.")),
      setErr(g, "e-msg", g.value.trim().length >= 10 ? "" : "Tulis pesan minimal 10 karakter.")
    ].every(Boolean);
    if (!ok) { (form.querySelector('[aria-invalid="true"]') || n).focus(); return; }
    const subject = encodeURIComponent("Proyek " + $("#f-type").value + " dari " + n.value.trim());
    const body = encodeURIComponent(g.value.trim() + "\n\n— " + n.value.trim() + " (" + m.value.trim() + ")");
    window.location.href = "mailto:" + CONFIG.email + "?subject=" + subject + "&body=" + body;
    showToast("Membuka aplikasi email Anda…");
    form.reset();
  });
  ["f-name","f-email","f-msg"].forEach(id => $("#" + id).addEventListener("input", ev => ev.target.setAttribute("aria-invalid","false")));
})();
</script>
</body>
</html>